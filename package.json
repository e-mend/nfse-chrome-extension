{
  "name": "baixar-nfse-extension",
  "version": "0.1.1",
  "description": "Baixar NFSe — Chrome extension (React + PrimeReact + RxDB skeleton)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:beta": "tsc --noEmit && vite build --mode beta",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/zip.mjs",
    "zip:internal": "node scripts/zip.mjs --with-sourcemaps",
    "zip:beta": "node scripts/zip.mjs --beta",
    "pack": "npm run build && npm run zip",
    "pack:beta": "npm run build:beta && npm run zip:beta",
    "clean": "rm -rf dist dist-beta dist-zip .vite"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.8",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rxdb": "^17.3.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.6.1",
    "@types/archiver": "^8.0.0",
    "@types/chrome": "^0.1.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "archiver": "^8.0.0",
    "javascript-obfuscator": "^5.4.3",
    "rollup-plugin-obfuscator": "^1.1.0",
    "terser": "^5.48.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
